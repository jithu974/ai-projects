NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# OrbStack local PostgreSQL (256m cap)
DATABASE_URL=postgresql://da_user:da_local_pass@127.0.0.1:5432/data_assistant
DB_POOL_MAX=5

# OrbStack local Redis (64m cap)
REDIS_URL=redis://127.0.0.1:6379/0

# Local Qdrant (opt-in Docker profile)
QDRANT_URL=http://127.0.0.1:6333

# Readiness probe timeout per dependency (ms)
HEALTH_CHECK_TIMEOUT_MS=2000