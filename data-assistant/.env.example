NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# OrbStack local PostgreSQL (256m cap)
DATABASE_URL=postgresql://da_user:da_local_pass@127.0.0.1:5432/data_assistant
DB_POOL_MAX=5

# OrbStack local Redis (64m cap)
REDIS_URL=redis://127.0.0.1:6379/0

# Local Qdrant (opt-in Docker profile)
QDRANT_URL=http://127.0.0.1:6333

# Readiness probe timeout per dependency (ms)
HEALTH_CHECK_TIMEOUT_MS=2000

# Phase 2 — Document Ingestion
UPLOAD_STORAGE_DIR=./.data/uploads
MAX_UPLOAD_SIZE_MB=25
INGESTION_CONCURRENCY=1
INGESTION_MAX_ATTEMPTS=3

# Phase 3 — Chunking & Metadata Engineering
CHUNKING_STRATEGY=markdown
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
PARENT_CHUNK_TOKENS=800
CHILD_CHUNK_TOKENS=200
TOKENIZER_CACHE_SIZE=5000

# Phase 4 — Zero-Cost Embeddings & Qdrant Cloud Free Tier
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_CACHE_TTL_SEC=604800

QDRANT_COLLECTION_ALIAS=chunks_live
QDRANT_COLLECTION_PREFIX=chunks

# Phase 5 — Free-Tier LLM Providers & Basic RAG
# Option A (Recommended free default — 15 RPM / 500 RPD):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-3.5-flash-lite
#   GEMINI_API_KEY=your-free-google-ai-studio-key
# Option B (Free fast fallback — 30 RPM / 1000 RPD / 8000 TPM):
#   LLM_PROVIDER=groq
#   LLM_MODEL=openai/gpt-oss-20b
#   GROQ_API_KEY=gsk_your-free-groq-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=2

# Basic RAG retrieval & context guardrails
# Note: 0.12 is tuned for 384-dim DeterministicEmbeddingProvider; recalibrate to ~0.35 for neural embeddings
RAG_DEFAULT_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.12
RAG_MAX_CONTEXT_TOKENS=2000
# Allow returning retrieved chunks + final constructed prompt when debug=true (keep false in production!)
RAG_DEBUG_ENABLED=true