{
  "name": "data-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=1536 tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS=--max-old-space-size=1536 node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@google/genai": "^3.6.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "bullmq": "^6.7.8",
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "^22.3.0",
    "gpt-tokenizer": "^4.1.2",
    "groq-sdk": "^1.6.0",
    "ioredis": "6.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pg": "8.23.1",
    "read-excel-file": "^9.3.14",
    "unpdf": "^2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "5.1.1"
  }
}
